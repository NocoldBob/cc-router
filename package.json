{
  "name": "cc-router",
  "private": true,
  "version": "0.2.0-beta.3",
  "description": "No-proxy, process-isolated Claude Code Provider launcher for Windows",
  "license": "MIT",
  "packageManager": "pnpm@10.33.0",
  "engines": {
    "node": ">=20"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NocoldBob/cc-router-windows.git"
  },
  "bugs": {
    "url": "https://github.com/NocoldBob/cc-router-windows/issues"
  },
  "homepage": "https://github.com/NocoldBob/cc-router-windows#readme",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "desktop:dev": "tauri dev",
    "desktop:build": "tauri build",
    "desktop:info": "tauri info",
    "vscode:check": "pnpm --dir vscode-extension check",
    "vscode:package": "pnpm --dir vscode-extension package:vsix",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "test": "vitest run",
    "preview": "vite preview"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.11.1",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.4",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.11"
  }
}
